{
  "name": "@diqier/stratagate",
  "version": "0.1.0",
  "private": true,
  "description": "Shared layered, evidence-gated memory engine used by StrataGate integrations",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build"
  },
  "keywords": [
    "agent-memory",
    "cross-session-memory",
    "persistent-memory",
    "layered-memory",
    "evidence-gate",
    "source-tracing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diqierjia/StrataGate-AgentMemory.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "better-sqlite3": "^12.11.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
