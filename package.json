{
  "name": "@diqier/agentmemory",
  "version": "0.1.0",
  "description": "Evidence-gated, source-preserving memory for long-running AI agents.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build"
  },
  "keywords": [
    "agent-memory",
    "long-term-memory",
    "llm",
    "ai-agents",
    "rag",
    "temporal-memory"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diqierjia/AgentMemory.git"
  },
  "bugs": {
    "url": "https://github.com/diqierjia/AgentMemory/issues"
  },
  "homepage": "https://github.com/diqierjia/AgentMemory#readme",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
