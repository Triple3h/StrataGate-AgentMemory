# Required for HTTP deployments. Keep this file private (chmod 600).
STRATAGATE_GATEWAY_TOKEN=replace-with-a-long-random-token
STRATAGATE_GATEWAY_PORT=43731
STRATAGATE_DATA_DIR=~/.stratagate/agent-memory
# Optional limits (bounded by the Gateway):
# STRATAGATE_GATEWAY_MAX_BODY_BYTES=4194304
# STRATAGATE_GATEWAY_MAX_CONCURRENT_REQUESTS=64
# STRATAGATE_GATEWAY_MAX_QUEUE_LENGTH=256
# STRATAGATE_GATEWAY_REQUEST_TIMEOUT_MS=30000
# STRATAGATE_GATEWAY_RATE_LIMIT_PER_MINUTE=600
