# Required for HTTP deployments. Keep this file private (chmod 600).
STRATAGATE_GATEWAY_TOKEN=replace-with-a-long-random-token
STRATAGATE_GATEWAY_PORT=43731
STRATAGATE_DATA_DIR=~/.stratagate/agent-memory
# Optional limits (bounded by the Gateway):
# STRATAGATE_GATEWAY_MAX_BODY_BYTES=4194304
# STRATAGATE_GATEWAY_MAX_CONCURRENT_REQUESTS=64
# STRATAGATE_GATEWAY_MAX_QUEUE_LENGTH=256
# STRATAGATE_GATEWAY_REQUEST_TIMEOUT_MS=30000
# STRATAGATE_GATEWAY_RATE_LIMIT_PER_MINUTE=600

# Optional: OpenAI-compatible model for background memory derivation
# (block sealing + event/element extraction). Without it the gateway runs in
# layered-raw mode: turns are stored but blocks stay unsearchable and no
# events/elements are derived. Inside Docker use host.docker.internal to reach
# a model proxy on the host.
# STRATAGATE_MODEL_BASE_URL=http://host.docker.internal:4000/v1
# STRATAGATE_MODEL=glm-5.3-flash
# STRATAGATE_MODEL_API_KEY=replace-with-model-api-key
# Per-call derivation model timeout (ms); default 90000, clamped 10000-600000.
# STRATAGATE_MODEL_TIMEOUT_MS=180000
